{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/layout/**",
              "components/thumbnails/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:customs|handle|color|key|ref|className|style|children)$/]",
        "message": "<BrandTag> doesn't accept that prop. Declared props: customs, handle, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|rule|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:faint|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'faint' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|key|ref|className|style|children)$/]",
        "message": "<Highlight> doesn't accept that prop. Declared props: children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:text|fill)$/]",
        "message": "<Highlight> variant must be one of 'text' | 'fill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<LineIcon> doesn't accept that prop. Declared props: name, size, color, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineIcon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:scale|ship|truck|car|document|container|globe|alert)$/]",
        "message": "<LineIcon> name must be one of 'scale' | 'ship' | 'truck' | 'car' | 'document' | 'container' | 'globe' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|motif|vignette|brand|handle|photo|photoPos|scrim|grade|pad|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<PostFrame> doesn't accept that prop. Declared props: children, motif, vignette, brand, handle, photo, photoPos, scrim, grade, pad, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='motif'] > Literal[value!=/^(?:routes|scale|combo|none)$/]",
        "message": "<PostFrame> motif must be one of 'routes' | 'scale' | 'combo' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:bottom|top|left|full)$/]",
        "message": "<PostFrame> scrim must be one of 'bottom' | 'top' | 'left' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|unitTone|size|key|ref|className|style|children)$/]",
        "message": "<StatNumber> doesn't accept that prop. Declared props: value, unit, unitTone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatNumber'] > JSXAttribute[name.name='unitTone'] > Literal[value!=/^(?:accent|white)$/]",
        "message": "<StatNumber> unitTone must be one of 'accent' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|key|ref|className|style|children)$/]",
        "message": "<TopicChips> doesn't accept that prop. Declared props: items, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicChips'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:faint|accent)$/]",
        "message": "<TopicChips> tone must be one of 'faint' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoThumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|photo|photoPos|scrim|grade|eyebrow|title|callout|calloutTone|brand|align|key|ref|className|style|children)$/]",
        "message": "<VideoThumb> doesn't accept that prop. Declared props: format, photo, photoPos, scrim, grade, eyebrow, title, callout, calloutTone, brand, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoThumb'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:youtube|shorts)$/]",
        "message": "<VideoThumb> format must be one of 'youtube' | 'shorts'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoThumb'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:bottom-left|bottom|full)$/]",
        "message": "<VideoThumb> scrim must be one of 'bottom-left' | 'bottom' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoThumb'] > JSXAttribute[name.name='calloutTone'] > Literal[value!=/^(?:hot|accent)$/]",
        "message": "<VideoThumb> calloutTone must be one of 'hot' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoThumb'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:bottom|center|top)$/]",
        "message": "<VideoThumb> align must be one of 'bottom' | 'center' | 'top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WarningStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|key|ref|className|style|children)$/]",
        "message": "<WarningStrip> doesn't accept that prop. Declared props: children, icon."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
